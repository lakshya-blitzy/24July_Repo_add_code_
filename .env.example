# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Security Configuration
HELMET_CONTENT_SECURITY_POLICY=default-src 'self'
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MESSAGE=Too many requests from this IP, please try again later

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE=logs/access.log
ERROR_LOG_FILE=logs/error.log

# Compression Configuration
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# Body Parser Configuration
BODY_PARSER_LIMIT=10mb
BODY_PARSER_EXTENDED=true

# PM2 Configuration
PM2_INSTANCES=max
PM2_EXEC_MODE=cluster
PM2_MAX_MEMORY_RESTART=300M
PM2_RESTART_DELAY=4000

# Development Configuration
NODEMON_WATCH=.
NODEMON_EXT=js,json,env
NODEMON_IGNORE=node_modules/,coverage/,logs/

# Test Configuration
JEST_COVERAGE_THRESHOLD=100
JEST_TEST_TIMEOUT=10000
JEST_VERBOSE=true

# Python Flask Configuration (for app.py)
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=localhost
FLASK_PORT=3000

# SSL/HTTPS Configuration (Production)
# SSL_CERT_PATH=path/to/certificate.crt
# SSL_KEY_PATH=path/to/private.key
# HTTPS_PORT=3443
# FORCE_HTTPS=false