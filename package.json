{
  "name": "nodejs-http-server-tutorial",
  "version": "1.0.0",
  "description": "A Node.js HTTP server tutorial project with progressive enhancement capabilities, demonstrating Express.js integration, Python Flask equivalent, comprehensive testing, and production deployment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --verbose --coverage",
    "test:watch": "jest --watch --verbose",
    "test:integration": "jest integration.test.js --verbose",
    "lint": "eslint . --ext .js --fix",
    "lint:check": "eslint . --ext .js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs"
  },
  "keywords": [
    "nodejs",
    "express",
    "http-server",
    "tutorial",
    "flask",
    "python",
    "jest",
    "testing",
    "pm2",
    "helmet",
    "cors",
    "rate-limiting",
    "security",
    "backprop"
  ],
  "author": "Blitzy Platform Tutorial",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^7.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.0"
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": [
      "@eslint/js/configs/recommended",
      "plugin:node/recommended",
      "plugin:jest/recommended"
    ],
    "plugins": [
      "node",
      "jest"
    ],
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "node/no-unpublished-require": "off",
      "node/no-missing-require": "error",
      "jest/no-disabled-tests": "warn",
      "jest/no-focused-tests": "error",
      "jest/no-identical-title": "error"
    }
  }
}
